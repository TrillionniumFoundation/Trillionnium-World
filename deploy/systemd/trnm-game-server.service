[Unit]
Description=TRNM Online Production v2 Game Server
After=network-online.target cex-trnm-ledger.service trnm-entitlement-signer.service
Wants=network-online.target cex-trnm-ledger.service trnm-entitlement-signer.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/qian/.openclaw/workspace/Trillionnium
ExecStart=/home/qian/.openclaw/workspace/Trillionnium/scripts/run-trnm-game-server.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/qian/.openclaw/workspace/Trillionnium/run

[Install]
WantedBy=default.target
