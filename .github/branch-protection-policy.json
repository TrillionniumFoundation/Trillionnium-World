{
  "contract_version": "trnm_world_branch_protection_policy_v1",
  "branch": "main",
  "required_pull_request": true,
  "required_approving_reviews": 1,
  "dismiss_stale_reviews": true,
  "require_code_owner_review": true,
  "require_conversation_resolution": true,
  "require_up_to_date_branch": true,
  "required_checks": [
    "repository-boundaries",
    "game-workspace",
    "supply-chain"
  ],
  "allow_force_pushes": false,
  "allow_deletions": false,
  "enforce_admins": true,
  "server_side_verified": false,
  "limitations": [
    "This file is the desired policy; GitHub repository settings remain the enforcement source of truth.",
    "server_side_verified must not become true without an exact GitHub API evidence record."
  ]
}
