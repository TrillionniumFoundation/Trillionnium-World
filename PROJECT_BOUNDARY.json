{
  "schema": 1,
  "project_id": "trillionnium-world",
  "canonical_dir": "trillionnium-world",
  "lane": "game-product",
  "lifecycle": "active",
  "development": true,
  "remote": {
    "policy": "required",
    "canonical_slug": "TrillionniumFoundation/Trillionnium-World",
    "visibility": "private",
    "upstream_required": true
  },
  "branch": {
    "protected": [
      "main",
      "master"
    ],
    "development_regex": "^(feature|fix|chore|docs|test)/world-[a-z0-9][a-z0-9._-]*$"
  },
  "cargo": {
    "workspace_manifest": "trillionnium/Cargo.toml",
    "expected_lane": "game-product",
    "required_packages": [
      "trnm-first-contact",
      "trnm-game-server",
      "trnm-rts-sim"
    ],
    "forbidden_packages": [
      "trnm-consensus-app",
      "trnm-runtime"
    ],
    "external_path_dependencies": "forbid"
  },
  "deny_changed_paths_regex": "^trillionnium/crates/platform/"
}
