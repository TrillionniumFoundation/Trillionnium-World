{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.invalid/schemas/world-v4-convergence-state-2026-08-30.schema.json",
  "title": "Trillionnium World V4 convergence state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "as_of",
    "repository",
    "plan",
    "addendum",
    "candidate",
    "observed_repository_controls",
    "release_posture",
    "counts",
    "items",
    "no_go"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "trnm_world_v4_convergence_state_v1" },
    "as_of": { "type": "string", "format": "date" },
    "repository": { "const": "TrillionniumFoundation/Trillionnium-World" },
    "plan": { "type": "string", "minLength": 1 },
    "addendum": { "type": "string", "minLength": 1 },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "parent_branch",
        "parent_commit",
        "main_observed",
        "overlapping_candidate"
      ],
      "properties": {
        "branch": { "const": "fix/world-plan-v4-convergence-2026-08-30" },
        "parent_branch": { "const": "fix/world-plan-gap-closure-v4" },
        "parent_commit": { "$ref": "#/$defs/sha" },
        "main_observed": { "$ref": "#/$defs/sha" },
        "overlapping_candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "commit", "disposition"],
          "properties": {
            "branch": { "type": "string", "minLength": 1 },
            "commit": { "$ref": "#/$defs/sha" },
            "disposition": { "const": "supersede_after_unique_change_review" }
          }
        }
      }
    },
    "observed_repository_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_check_runs",
        "overlapping_candidate_check_runs",
        "ruleset_count",
        "actions_probe",
        "branch_protection_observed",
        "required_checks_observed",
        "code_owner_review_enforced_observed",
        "administrators_enforced_observed"
      ],
      "properties": {
        "candidate_check_runs": { "type": "integer", "minimum": 0 },
        "overlapping_candidate_check_runs": { "type": "integer", "minimum": 0 },
        "ruleset_count": { "type": "integer", "minimum": 0 },
        "actions_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "commit", "workflow_runs", "interpretation"],
          "properties": {
            "branch": { "type": "string", "minLength": 1 },
            "commit": { "$ref": "#/$defs/sha" },
            "workflow_runs": { "type": "integer", "minimum": 0 },
            "interpretation": {
              "const": "repository_or_organization_actions_execution_not_observed"
            }
          }
        },
        "branch_protection_observed": { "type": "boolean" },
        "required_checks_observed": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "code_owner_review_enforced_observed": { "type": "boolean" },
        "administrators_enforced_observed": { "type": "boolean" }
      }
    },
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical_source_candidate",
        "exact_head_remote_verification",
        "trusted_deployed_settlement",
        "canonical_nakama_online_authority",
        "public_online",
        "public_player_market",
        "commercial_release"
      ],
      "properties": {
        "technical_source_candidate": { "const": "in_progress" },
        "exact_head_remote_verification": { "const": "repository_control_blocked" },
        "trusted_deployed_settlement": { "const": "environment_evidence_required" },
        "canonical_nakama_online_authority": { "const": "blocked_upstream" },
        "public_online": { "const": "no_go" },
        "public_player_market": { "const": "disabled" },
        "commercial_release": { "const": "no_go" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_open",
        "source_implemented_unverified",
        "source_verified",
        "repository_control_blocked",
        "blocked_upstream",
        "environment_evidence_required",
        "human_evidence_required",
        "commercial_approval_required",
        "closed"
      ],
      "properties": {
        "source_open": { "type": "integer", "minimum": 0 },
        "source_implemented_unverified": { "type": "integer", "minimum": 0 },
        "source_verified": { "type": "integer", "minimum": 0 },
        "repository_control_blocked": { "type": "integer", "minimum": 0 },
        "blocked_upstream": { "type": "integer", "minimum": 0 },
        "environment_evidence_required": { "type": "integer", "minimum": 0 },
        "human_evidence_required": { "type": "integer", "minimum": 0 },
        "commercial_approval_required": { "type": "integer", "minimum": 0 },
        "closed": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "state",
          "claim",
          "evidence_required",
          "next_gate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^WORLD-[A-Z0-9-]+$" },
          "owner": { "type": "string", "minLength": 1 },
          "state": { "$ref": "#/$defs/state" },
          "claim": { "type": "string", "minLength": 1 },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "next_gate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "no_go": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "source_open",
        "source_implemented_unverified",
        "source_verified",
        "repository_control_blocked",
        "blocked_upstream",
        "environment_evidence_required",
        "human_evidence_required",
        "commercial_approval_required",
        "closed"
      ]
    }
  }
}
