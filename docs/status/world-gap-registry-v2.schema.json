{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trillionnium.invalid/schemas/trnm-world-gap-registry-v2.schema.json",
  "title": "Trillionnium World gap registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "as_of",
    "repository",
    "source_base_commit",
    "candidate_branch",
    "release_posture",
    "counts",
    "gaps",
    "closure_rule"
  ],
  "properties": {
    "schema": {"const": "trnm_world_gap_registry_v2"},
    "as_of": {"type": "string", "format": "date"},
    "repository": {"const": "TrillionniumFoundation/Trillionnium-World"},
    "source_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_branch": {"type": "string", "minLength": 1, "maxLength": 256},
    "release_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineering", "player_product", "public_online", "public_player_market", "commercial_release"],
      "properties": {
        "engineering": {"const": "technical_alpha"},
        "player_product": {"const": "pre_alpha"},
        "public_online": {"const": "no_go"},
        "public_player_market": {"const": "disabled"},
        "commercial_release": {"const": "no_go"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed", "implemented_unverified", "source_gap", "planned_or_partial", "blocked_upstream", "server_configuration_required", "external_evidence_required_or_blocked"],
      "properties": {
        "closed": {"type": "integer", "minimum": 0},
        "implemented_unverified": {"type": "integer", "minimum": 0},
        "source_gap": {"type": "integer", "minimum": 0},
        "planned_or_partial": {"type": "integer", "minimum": 0},
        "blocked_upstream": {"type": "integer", "minimum": 0},
        "server_configuration_required": {"type": "integer", "minimum": 0},
        "external_evidence_required_or_blocked": {"type": "integer", "minimum": 0}
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "owner", "summary", "next_gate", "release_effect"],
        "properties": {
          "id": {"type": "string", "pattern": "^WORLD-P[0-2]-[0-9]{3}$"},
          "class": {
            "enum": ["closed", "implemented_unverified", "source_gap", "planned_or_partial", "blocked_upstream", "server_configuration_required", "external_evidence_required_or_blocked"]
          },
          "owner": {"type": "string", "minLength": 1, "maxLength": 256},
          "summary": {"type": "string", "minLength": 8, "maxLength": 1024},
          "next_gate": {"type": "string", "minLength": 8, "maxLength": 1024},
          "release_effect": {"type": "string", "minLength": 1, "maxLength": 256}
        }
      }
    },
    "closure_rule": {"type": "string", "minLength": 16, "maxLength": 2048}
  }
}
