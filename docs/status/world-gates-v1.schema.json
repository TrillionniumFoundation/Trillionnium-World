{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trnm://world/status/world-gates-v1.schema.json",
  "title": "Trillionnium World product gates v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "as_of",
    "source_plan",
    "gates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "const": "trillionnium-world" },
    "as_of": { "type": "string", "format": "date" },
    "source_plan": { "type": "string", "minLength": 1 },
    "gates": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "commit_sha",
        "tree_sha",
        "workflow_url",
        "result",
        "limitations",
        "reviewed_at"
      ],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "workflow_url": { "type": "string", "pattern": "^https://github\\.com/.+/actions/runs/[0-9]+(?:/.*)?$" },
        "result": { "enum": ["passed", "failed", "invalid"] },
        "environment": { "type": "string" },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "reviewed_at": { "type": "string", "format": "date" },
        "review_due": { "type": "string", "format": "date" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "authority_profile",
        "evidence",
        "blockers",
        "limitations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "status": {
          "enum": [
            "planned",
            "implemented",
            "verified_local",
            "verified_remote",
            "deployed",
            "operational",
            "release_ready",
            "blocked",
            "no_go",
            "disabled"
          ]
        },
        "authority_profile": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
