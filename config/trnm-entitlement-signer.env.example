# Copy to $HOME/.config/trillionnium-world/entitlement-signer.env and chmod 0600.
# This file must not contain game-authority or moderator credentials.

DATABASE_URL=REPLACE_WITH_POSTGRESQL_CONNECTION_STRING
TRNM_GAME_SERVER_RELEASE_DIR=REPLACE_WITH_ABSOLUTE_VERIFIED_RELEASE_DIRECTORY
TRNM_ENTITLEMENT_SIGNER_TOKEN=REPLACE_WITH_INDEPENDENT_SIGNER_SERVICE_SECRET
TRNM_ENTITLEMENT_SIGNER_BIND_ADDR=127.0.0.1:7010
TRNM_ENTITLEMENT_KEY_DIR=REPLACE_WITH_ABSOLUTE_PRIVATE_SIGNER_KEY_DIRECTORY
TRNM_ENTITLEMENT_ED25519_PRIVATE_KEY_FILE=REPLACE_WITH_ABSOLUTE_MODE_0600_PRIVATE_SEED_FILE
TRNM_ENTITLEMENT_ED25519_KEY_ID_FILE=REPLACE_WITH_ABSOLUTE_ACTIVE_KEY_ID_FILE
TRNM_ALLOW_DEV_BINARY=0
