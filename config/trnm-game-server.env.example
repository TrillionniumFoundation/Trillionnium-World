# Copy to $HOME/.config/trillionnium-world/game-server.env and chmod 0600.
# Replace every REPLACE_* value before starting the service.

DATABASE_URL=REPLACE_WITH_POSTGRESQL_CONNECTION_STRING
TRNM_GAME_SERVER_RELEASE_DIR=REPLACE_WITH_ABSOLUTE_VERIFIED_RELEASE_DIRECTORY
TRNM_CEX_LEDGER_URL=http://127.0.0.1:7002
TRNM_ENTITLEMENT_SIGNER_URL=http://127.0.0.1:7010

# These three credentials must be independently generated and pairwise distinct.
TRNM_GAME_AUTHORITY_TOKEN=REPLACE_WITH_INDEPENDENT_GAME_AUTHORITY_SECRET
TRNM_MODERATOR_TOKEN=REPLACE_WITH_INDEPENDENT_MODERATOR_SECRET
TRNM_ENTITLEMENT_SIGNER_TOKEN=REPLACE_WITH_INDEPENDENT_SIGNER_SERVICE_SECRET

TRNM_ASSET_ROOT=REPLACE_WITH_ABSOLUTE_WORLD_ASSET_DIRECTORY
TRNM_PUBLISHED_TICK_JOURNAL_DIR=REPLACE_WITH_ABSOLUTE_PRIVATE_JOURNAL_DIRECTORY
TRNM_FLEET_INSTANCE_ID=trnm-primary
TRNM_FLEET_PHYSICAL_HOST_ID=REPLACE_WITH_STABLE_PHYSICAL_HOST_ID
TRNM_FLEET_REGION=REPLACE_WITH_REGION
TRNM_FLEET_PUBLIC_ENDPOINT=http://127.0.0.1:7005
TRNM_FLEET_CAPACITY=4
TRNM_GAME_SERVER_BIND_ADDR=127.0.0.1:7005
TRNM_GAME_SERVER_TICK_MS=100
TRNM_PRODUCTION_RATE_LIMIT_PER_MINUTE=600
TRNM_PRODUCTION_REQUEST_BODY_LIMIT_BYTES=262144
TRNM_ALLOW_DEV_BINARY=0
