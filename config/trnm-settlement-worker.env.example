# Copy to $HOME/.config/trillionnium-world/settlement-worker.env and chmod 0600.
# Replace every REPLACE_* value before starting the service.

DATABASE_URL=REPLACE_WITH_POSTGRESQL_CONNECTION_STRING
TRNM_CEX_LEDGER_URL=http://127.0.0.1:7002
TRNM_ENTITLEMENT_SIGNER_URL=http://127.0.0.1:7010

# These credentials must be independently generated and must match the
# corresponding CEX/signer service configuration. The signer private key is
# never present in this file or exported to the worker.
TRNM_GAME_AUTHORITY_TOKEN=REPLACE_WITH_INDEPENDENT_GAME_AUTHORITY_SECRET
TRNM_ENTITLEMENT_SIGNER_TOKEN=REPLACE_WITH_INDEPENDENT_SIGNER_SERVICE_SECRET

# Formal deployments select a concrete executable plus its reviewed digest.
# Development fallback is accepted only when TRNM_ALLOW_DEV_BINARY=1.
TRNM_SETTLEMENT_WORKER_BINARY=REPLACE_WITH_ABSOLUTE_SETTLEMENT_WORKER_BINARY
TRNM_SETTLEMENT_WORKER_SHA256=REPLACE_WITH_64_HEX_BINARY_DIGEST
TRNM_ALLOW_DEV_BINARY=0

TRNM_SETTLEMENT_WORKER_ID=trnm-settlement-primary
TRNM_SETTLEMENT_BATCH_SIZE=8
TRNM_SETTLEMENT_MAX_IN_FLIGHT=8
TRNM_SETTLEMENT_LEASE_MILLISECONDS=120000
TRNM_SETTLEMENT_POLL_MILLISECONDS=250
TRNM_SETTLEMENT_DATABASE_MAX_CONNECTIONS=4

# On SIGINT/SIGTERM the worker stops capture/claim admission immediately, drains
# already-started remote calls for this bounded interval, then aborts remaining
# futures and relies on generation-fenced lease expiry for recovery.
TRNM_SETTLEMENT_SHUTDOWN_GRACE_MILLISECONDS=20000

RUST_LOG=trnm_settlement_worker=info
