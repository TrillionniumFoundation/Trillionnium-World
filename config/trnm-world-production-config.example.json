{
  "schema": "trillionnium_world_production_config_v1",
  "authority_mode": "nakama_only",
  "environment": "production-candidate",
  "deployment_id": "replace-with-deployment-identity",
  "component_lock_id": "replace-with-integration-lock-id",
  "source_commit": "0000000000000000000000000000000000000000",
